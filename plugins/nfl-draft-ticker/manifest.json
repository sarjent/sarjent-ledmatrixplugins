{
  "id": "nfl-draft-ticker",
  "name": "NFL Draft Ticker",
  "version": "1.5.8",
  "author": "sarjent",
  "description": "Displays projected and live NFL Draft Ticker picks from ESPN with live draft tracking support during the annual NFL Draft event. Includes simulate_live mode to replay a completed draft using real ESPN core API data. Shows team logos, player names, positions, and pick numbers in a scrolling display. Off-season modes display weekly stat leaders and injury/OTA reports year-round.",
  "entry_point": "manager.py",
  "class_name": "NFLDraftPlugin",
  "category": "sports",
  "tags": [
    "nfl",
    "draft",
    "ticker",
    "football",
    "sports",
    "espn"
  ],
  "display_modes": [
    "nfl_draft_ticker",
    "nfl_leaders_ticker",
    "nfl_injuries_ticker"
  ],
  "update_interval": 300,
  "default_duration": 60,
  "compatible_versions": [
    ">=2.0.0"
  ],
  "icon": "fas fa-football-ball",
